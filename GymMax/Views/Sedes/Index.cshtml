@model IEnumerable<Sede>

@{
    ViewData["Title"] = "Nuestras Sedes";
}

<section class="bg-gray-900 text-white py-20">

    <div class="max-w-7xl mx-auto px-6 text-center">

        <h1 class="text-5xl font-bold">
            Nuestras Sedes
        </h1>

        <p class="mt-5 text-gray-300">
            Encuentra el gimnasio GymMax más cercano y comienza a entrenar.
        </p>

    </div>

</section>

<section class="py-20 bg-gray-100">

    <div class="max-w-7xl mx-auto px-6 space-y-10">

        @if (!Model.Any())
        {
            <div class="text-center py-12">
                <i class="fa-solid fa-location-dot text-4xl text-gray-400"></i>

                <h2 class="mt-4 text-2xl font-semibold text-gray-700">
                    No hay sedes disponibles
                </h2>

                <p class="mt-2 text-gray-500">
                    Actualmente no tenemos sedes disponibles para mostrar.
                </p>
            </div>
        }
        else
        {
            @foreach (var sede in Model)
            {
                <div class="bg-white rounded-xl shadow-lg p-8 flex flex-col lg:flex-row justify-between items-center gap-8 transition duration-300 hover:-translate-y-1 hover:shadow-xl">

                    <div class="w-full">

                        <h2 class="text-3xl font-bold text-gray-900">
                            @sede.Nombre
                        </h2>

                        <p class="mt-4 text-gray-600">
                            <i class="fa-solid fa-location-dot text-red-600 mr-2"></i>
                            @sede.Direccion
                        </p>

                        <p class="mt-2 text-gray-600">
                            <i class="fa-solid fa-phone text-red-600 mr-2"></i>
                            @sede.Telefono
                        </p>

                        <p class="mt-2 text-gray-600">
                            <i class="fa-solid fa-clock text-red-600 mr-2"></i>
                            @sede.Horario
                        </p>

                    </div>

                    <div class="shrink-0">

                        <button
                            type="button"
                            class="bg-red-600 text-white px-8 py-3 rounded-lg font-semibold transition duration-300 hover:bg-red-700 hover:shadow-lg">

                            Ver ubicación

                        </button>

                    </div>

                </div>
            }
        }

    </div>

</section>