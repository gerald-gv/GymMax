@model IEnumerable<Sede>

@{
    ViewData["Title"] = "Nuestras Sedes";
}

<!-- HERO -->
<section class="relative overflow-hidden bg-gray-950 py-20 text-white sm:py-24">

    <!-- BRILLO SUP DERECHO -->
    <div class="absolute -right-32 -top-32 h-72 w-72 rounded-full bg-red-600/10 blur-3xl"></div>

    <!-- BRILLO INF IZQUIERDO -->
    <div class="absolute -bottom-32 -left-32 h-72 w-72 rounded-full bg-red-600/10 blur-3xl"></div>

    <!-- CONTENIDO -->
    <div class="relative mx-auto max-w-7xl px-5 text-center sm:px-6 lg:px-10">

        <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.22em] text-red-500 sm:text-sm">
            <span class="h-px w-6 bg-red-500 sm:w-8"></span>
            GymMax
        </span>


        <h1 class="mt-5 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
            Nuestras sedes
        </h1>


        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-gray-400 sm:text-lg">
            Encuentra el gimnasio GymMax más cercano y entrena
            en un espacio preparado para ayudarte a alcanzar tus objetivos.
        </p>

    </div>
</section>

<!-- SEDES -->
<section class="bg-gray-100 py-20 sm:py-24">

    <!-- CONTENIDO -->
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-10">

        @if (!Model.Any()) {

            <div class="mx-auto max-w-xl rounded-3xl border border-gray-200 bg-white px-6 py-16 text-center shadow-lg">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-red-100">
                    <i class="fa-solid fa-location-dot text-2xl text-red-600"></i>
                </div>


                <h2 class="mt-6 text-2xl font-bold text-gray-900">
                    No hay sedes disponibles
                </h2>


                <p class="mt-3 text-gray-500">
                    Actualmente no tenemos sedes disponibles para mostrar.
                </p>

            </div>
        } else {
            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">

                @foreach (var sede in Model) {
                    <article class="group flex h-full flex-col rounded-3xl border border-gray-200 bg-white p-7 shadow-lg transition duration-300 hover:-translate-y-2 hover:shadow-2xl sm:p-8">

                        <div class="flex items-start justify-between gap-4">

                            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-red-100">
                                <i class="fa-solid fa-location-dot text-2xl text-red-600"></i>
                            </div>


                            @if (sede.Activo) {

                                <span class="inline-flex items-center gap-2 rounded-full bg-green-50 px-3 py-1.5 text-xs font-semibold text-green-700">
                                    <span class="h-2 w-2 rounded-full bg-green-500"></span>
                                    Disponible
                                </span>

                            } else {

                                <span class="inline-flex items-center gap-2 rounded-full bg-gray-100 px-3 py-1.5 text-xs font-semibold text-gray-500">
                                    <span class="h-2 w-2 rounded-full bg-gray-400"></span>
                                    No disponible
                                </span>
                            }
                        </div>


                        <h2 class="mt-7 text-2xl font-bold text-gray-900">
                            @sede.Nombre
                        </h2>


                        <div class="mt-6 space-y-4">

                            <div class="flex items-start gap-3">
                                <i class="fa-solid fa-location-dot mt-1 w-5 text-center text-red-600"></i>

                                <div>
                                    <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
                                        Dirección
                                    </p>
                                    <p class="mt-1 text-sm leading-relaxed text-gray-600">
                                        @sede.Direccion
                                    </p>
                                </div>

                            </div>


                            <div class="flex items-start gap-3">
                                <i class="fa-solid fa-phone mt-1 w-5 text-center text-red-600"></i>
                                
                                <div>

                                    <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
                                        Teléfono
                                    </p>
                                    <p class="mt-1 text-sm text-gray-600">
                                        @sede.Telefono
                                    </p>

                                </div>

                            </div>


                            <div class="flex items-start gap-3">
                                <i class="fa-solid fa-clock mt-1 w-5 text-center text-red-600"></i>

                                <div>
                                    <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
                                        Horario
                                    </p>
                                    <p class="mt-1 text-sm leading-relaxed text-gray-600">
                                        @sede.Horario
                                    </p>
                                </div>

                            </div>
                        </div>


                        <div class="mt-8 border-t border-gray-100 pt-6">

                            @if (sede.Activo) {
                                <a href="#" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gray-950 px-5 py-3.5 text-sm font-semibold text-white transition duration-300 hover:bg-red-600">
                                    Ver ubicación
                                    <i class="fa-solid fa-arrow-right text-xs"></i>
                                </a>
                            } else {
                                <button type="button" disabled class="w-full cursor-not-allowed rounded-xl bg-gray-100 px-5 py-3.5 text-sm font-semibold text-gray-400">
                                    Sede no disponible
                                </button>
                            }

                        </div>

                    </article>
                }
            </div>
        }
    </div>
</section>