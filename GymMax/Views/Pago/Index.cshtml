@model IEnumerable<GymMax.Models.Pago>
@{ ViewData["Title"] = "Pagos"; }

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark m-0">Pagos</h2>
            <p class="text-muted small m-0">Historial de pagos registrados en el sistema.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-3">Cliente</th>
                            <th>Plan</th>
                            <th>@Html.DisplayNameFor(m => m.Monto)</th>
                            <th>@Html.DisplayNameFor(m => m.FechaPago)</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                        <tr>
                            <td class="ps-3 fw-medium">
                                <i class="bi bi-person-fill text-primary me-1"></i>
                                @item.Suscripcion?.Usuario?.Nombres @item.Suscripcion?.Usuario?.Apellidos
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.Suscripcion?.Plan?.Nombre
                                </span>
                            </td>
                            <td class="fw-semibold text-success">S/ @item.Monto.ToString("N2")</td>
                            <td class="text-nowrap text-muted">@item.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.PagoId" class="btn btn-outline-info" title="Detalles"><i class="bi bi-eye-fill"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.PagoId" class="btn btn-outline-danger" title="Eliminar"><i class="bi bi-trash-fill"></i></a>
                                </div>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
