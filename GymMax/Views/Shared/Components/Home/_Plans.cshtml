<section id="planes" class="bg-gray-50 py-24">

    <div class="mx-auto max-w-7xl px-6">

        <!-- ENCABEZADO -->

        <div class="mx-auto max-w-2xl text-center">

            <span class="text-sm font-semibold uppercase tracking-[0.2em] text-red-600">
                Nuestros planes
            </span>

            <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
                Planes diseñados para ti
            </h2>

            <p class="mt-5 text-lg leading-relaxed text-gray-500">
                Elige la membresía que mejor se adapte a tus objetivos
                y comienza a entrenar con GymMax.
            </p>

        </div>

        <!-- CARDS -->

        <div class="mt-16 grid gap-8 md:grid-cols-3">

            @foreach (var plan in Model.Planes) {
                <article class="group relative flex flex-col overflow-hidden rounded-3xl border border-gray-200 bg-white p-8 shadow-lg transition duration-500 hover:-translate-y-2 hover:shadow-2xl">

                    <div class="flex items-center justify-between">

                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-100 text-red-600 transition duration-300 group-hover:bg-red-600 group-hover:text-white">
                            <i class="fa-solid fa-dumbbell text-xl"></i>
                        </div>

                        <!-- DISPONIBILIDAD -->

                        @if (plan.Activo) {
                            <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">
                                Disponible
                            </span>
                        } else {

                            <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">
                                No Disponible
                            </span>
                        }

                    </div>

                    <!-- CONTENIDO -->

                    <div class="mt-7">

                        <h3 class="text-2xl font-bold text-gray-900">
                            @plan.Nombre
                        </h3>

                        <p class="mt-3 min-h-[48px] leading-relaxed text-gray-500">
                            @plan.Descripcion
                        </p>

                    </div>

                    <div class="mt-8">

                        <span class="text-5xl font-extrabold tracking-tight text-gray-950">
                            S/@plan.Precio.ToString("0.00")
                        </span>

                    </div>

                    <div class="mt-6 flex items-center gap-3 border-t border-gray-100 pt-6 text-gray-600">

                        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-gray-100">
                            <i class="fa-regular fa-calendar text-sm"></i>
                        </div>

                        <div>

                            <p class="text-xs font-medium uppercase tracking-wide text-gray-400"> Duración </p>

                            <p class="font-semibold text-gray-700">
                                @plan.DuracionDias días
                            </p>

                        </div>

                    </div>


                    <div class="mt-8 flex-grow">

                        <div class="flex items-start gap-3 text-sm text-gray-600">
                            <i class="fa-solid fa-circle-check mt-0.5 text-red-500"></i>
                            <span> Acceso según las condiciones del plan </span>
                        </div>

                    </div>


                    <a asp-controller="Planes" asp-action="Index" class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gray-950 px-6 py-3.5 font-semibold text-white transition duration-300 hover:bg-red-600">
                        Ver detalles
                        <i class="fa-solid fa-arrow-right text-sm transition-transform duration-300 group-hover:translate-x-1"></i>
                    </a>

                </article>
            }

        </div>

        <div class="mt-12 text-center">

            <a asp-controller="Planes" asp-action="Index" class="inline-flex items-center gap-2 font-semibold text-red-600 transition hover:text-red-700">
                Ver todos los planes
                <i class="fa-solid fa-arrow-right transition-transform duration-300 hover:translate-x-1"></i>
            </a>

        </div>

    </div>
</section>