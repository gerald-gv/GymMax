<section id="planes" class="py-24 bg-gray-100">

    <div class="max-w-7xl mx-auto px-6">

        <div class="text-center">

            <h2 class="text-4xl font-bold text-gray-900">
                Planes diseñados para ti
            </h2>

            <p class="mt-4 text-gray-500">
                Elige el entrenamiento que mejor se adapte a tus objetivos.
            </p>

        </div>


        <div class="grid md:grid-cols-3 gap-8 mt-16">

            @foreach (var plan in Model.Planes) {
                <div class="bg-white rounded-3xl p-8 shadow-lg border border-gray-200 hover:-translate-y-3 hover:shadow-2xl transition duration-500">

                    <h3 class="text-2xl font-bold">
                        @plan.Nombre
                    </h3>

                    <p class="text-gray-500 mt-2">
                        @plan.Descripcion
                    </p>


                    <div class="mt-6">

                        <span class="text-5xl font-extrabold">
                            S/@plan.Precio.ToString("0.00")
                        </span>

                    </div>


                    <ul class="mt-8 space-y-4 text-gray-600">

                        <li>
                            <i class="fa-solid fa-check text-red-500 mr-2"></i>
                            @plan.Descripcion
                        </li>

                        <li>
                            <i class="fa-solid fa-calendar text-red-500 mr-2"></i>
                            Duración: @plan.DuracionDias días
                        </li>

                        <li>
                            <i class="fa-solid fa-circle-check text-red-500 mr-2"></i>
                            Plan disponible
                        </li>

                    </ul>


                    <a asp-controller="Planes"
                           asp-action="Index"
                           class="mt-10 block w-full py-3 text-center rounded-xl border border-red-500 text-red-600 hover:bg-red-600 hover:text-white transition">

                        Ver planes

                    </a>

                </div>
            }

        </div>


        <div class="text-center mt-12">

            <a asp-controller="Planes"
                   asp-action="Index"
                   class="inline-flex items-center gap-2 text-red-600 font-semibold hover:text-red-700 transition">

                Ver todos los planes

                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </div>

    </div>

</section>