<section class="relative min-h-[calc(100svh-80px)] overflow-hidden text-white">
    
    <!-- VIDEO -->
    <video class="hero-video absolute inset-0 h-full w-full object-cover object-center" autoplay muted loop playsinline aria-hidden="true">
        <source src="~/videos/HeroGymMax.mp4" type="video/mp4" />
    </video>

    <div class="absolute inset-0 bg-black/25"></div>

    <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/35 to-transparent"></div>

    <!-- CONTENIDO -->
    <div class="relative z-10 flex min-h-[calc(100svh-80px)] items-center">

        <div class="mx-auto w-full max-w-7xl px-6 py-20 sm:px-8 lg:px-10 lg:py-24">

            <div class="max-w-3xl">

                <!-- ETIQUETA -->
                <div class="hero-content">

                    <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.22em] text-red-500 sm:text-sm">
                        <span class="h-px w-6 bg-red-500 sm:w-8"></span>
                        Gimnasio GymMax
                    </span>

                </div>

                <!-- TITULO -->
                <div class="hero-content">

                    <h1 class="mt-5 text-5xl font-extrabold leading-[1.05] tracking-tight sm:mt-6 sm:text-6xl lg:text-7xl xl:text-8xl">
                        Construye tu mejor versión.
                        <span class="mt-1 block text-red-500">Sin límites.</span>
                    </h1>

                </div>

                <!-- DESCRIPCION -->
                <div class="hero-content">

                    <p class="mt-6 max-w-2xl text-base leading-relaxed text-gray-200 sm:mt-7 sm:text-lg lg:text-xl">
                        Entrena con equipos profesionales, coaches especializados
                        y planes diseñados para ayudarte a alcanzar tus objetivos.
                    </p>

                </div>


                <!-- BOTONES -->
                <div class="hero-actions mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row sm:gap-4">

                    <a asp-controller="Planes" asp-action="Index" class="inline-flex items-center justify-center rounded-xl bg-red-600 px-7 py-3.5 font-semibold text-white shadow-lg shadow-red-600/20 transition duration-300 hover:-translate-y-0.5 hover:bg-red-700 sm:px-8 sm:py-4">
                        Ver planes
                        <i class="fa-solid fa-arrow-right ml-3"></i>
                    </a>


                    <a asp-controller="Sedes" asp-action="Index" class="inline-flex items-center justify-center rounded-xl border border-white/30 bg-white/10 px-7 py-3.5 font-semibold text-white backdrop-blur-sm transition duration-300 hover:-translate-y-0.5 hover:bg-white/20 sm:px-8 sm:py-4">
                        Nuestras sedes
                        <i class="fa-solid fa-location-dot ml-3"></i>
                    </a>

                </div>


                <!-- CARACTERISTICAS -->
                <div class="hero-features mt-10 flex flex-col gap-4 text-sm text-gray-200 sm:mt-12 sm:flex-row sm:flex-wrap sm:gap-x-8 sm:gap-y-4">

                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-dumbbell text-red-500"></i>
                        <span>
                            Equipamiento profesional
                        </span>
                    </div>


                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-user-tie text-red-500"></i>
                        <span>
                            Coaches especializados
                        </span>
                    </div>


                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-location-dot text-red-500"></i>
                        <span>
                            3 sedes
                        </span>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>