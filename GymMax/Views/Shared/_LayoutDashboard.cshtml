﻿
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymMax</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymMax.styles.css" asp-append-version="true" />
    <style>
            .sidebar-link {
                color: rgba(255, 255, 255, 0.75);
                transition: all 0.2s ease-in-out;
                border-radius: 0.5rem;
            }

                .sidebar-link:hover, .sidebar-link.active {
                    color: #ffffff;
                    background-color: rgba(255, 255, 255, 0.1);
                }
    </style>
</head>
    <body class="bg-light">
    <!-- SIDEBAR OFFCANVAS -->
    <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel" style="width: 280px;">

            <div class="offcanvas-header border-bottom border-secondary">
                <a href="/" class="d-flex align-items-center text-white text-decoration-none">
            <span class="fs-4 fw-bold" id="sidebarMenuLabel">GymMax</span>
            </a>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

            <div class="offcanvas-body p-3">
            <ul class="nav nav-pills flex-column gap-1">

                <li class="nav-item">
                    <a class="nav-link sidebar-link d-flex align-items-center gap-3 px-3 py-2"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        <i class="bi bi-speedometer2 fs-5"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                    <li class="nav-item">
                        <a class="nav-link sidebar-link d-flex align-items-center gap-3 px-3 py-2"
                           asp-controller="Usuarios"
                           asp-action="Index">
                        <i class="bi bi-people fs-5"></i>
                    <span>Usuarios</span>
                </a>
                </li>

                    <li class="nav-item">
                        <a class="nav-link sidebar-link d-flex align-items-center gap-3 px-3 py-2"
                           asp-controller="Plan"
                           asp-action="Index">
                        <i class="bi bi-card-checklist fs-5"></i>
                    <span>Planes</span>
                </a>
                </li>

                    <li class="nav-item">
                        <a class="nav-link sidebar-link d-flex align-items-center gap-3 px-3 py-2"
                           asp-controller="Sede"
                           asp-action="Index">
                        <i class="bi bi-geo-alt fs-5"></i>
                    <span>Sedes</span>
                </a>
                </li>

                    <li class="nav-item">
                        <a class="nav-link sidebar-link d-flex align-items-center gap-3 px-3 py-2"
                           asp-controller="Coach"
                           asp-action="Index">
                        <i class="bi bi-person-badge fs-5"></i>
                    <span>Coaches</span>
                </a>
                </li>

                    <li class="nav-item">
                        <a class="nav-link sidebar-link d-flex align-items-center gap-3 px-3 py-2"
                           asp-controller="Suscripcion"
                           asp-action="Index">
                        <i class="bi bi-credit-card-2-front fs-5"></i>
                    <span>Suscripciones</span>
                </a>
                </li>

                    <li class="nav-item">
                        <a class="nav-link sidebar-link d-flex align-items-center gap-3 px-3 py-2"
                           asp-controller="Pago"
                           asp-action="Index">
                        <i class="bi bi-cash-stack fs-5"></i>
                    <span>Pagos</span>
                </a>
                </li>

                    <li class="nav-item">
                        <a class="nav-link sidebar-link d-flex align-items-center gap-3 px-3 py-2"
                           asp-controller="Asistencia"
                           asp-action="Index">
                        <i class="bi bi-calendar-check fs-5"></i>
                    <span>Asistencias</span>
                </a>
                </li>

        </ul>
    </div>
    </div>


    <!-- CONTENIDO PRINCIPAL -->
    <div class="d-flex flex-column vh-100 overflow-auto">

        <!-- HEADER SUPERIOR CON BOTÓN TOGGLE -->
            <header class="bg-white border-bottom px-4 py-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">

                    <div class="d-flex align-items-center gap-3">
                    <!-- BOTÓN PARA ABRIR EL SIDEBAR -->
                        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
                    <i class="bi bi-list fs-5"></i>
                    </button>

                        <h4 class="m-0 fw-semibold text-dark">
                    @ViewData["Title"]
                </h4>
                </div>

                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                    <i class="bi bi-person-fill"></i>
                    </div>
                    <span class="fw-medium text-secondary fs-6">@User.Identity?.Name</span>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-box-arrow-right"></i> Salir
                    </button>
                </form>
                </div>

        </div>
        </header>


        <!-- VISTAS CRUD -->
            <main class="p-4 flex-grow-1">
        @RenderBody()
        </main>


        <!-- FOOTER -->
            <footer class="border-top text-muted p-3 text-center bg-white fs-7">
        &copy; 2026 - <span class="fw-semibold text-dark">GymMax</span>. Todos los derechos reservados.
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>