@model GymMax.Models.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<div class="container-fluid p-0">

    <!-- Saludo -->
    <div class="mb-4">
        <h2 class="h3 fw-bold text-dark m-0">Bienvenido, @User.Identity?.Name</h2>
        <p class="text-muted small m-0">Resumen general del gimnasio al día de hoy.</p>
    </div>

    <!-- Tarjetas de métricas principales -->
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary-subtle text-primary">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Total Usuarios</p>
                        <h4 class="fw-bold mb-0">@Model.TotalUsuarios</h4>
                        <small class="text-muted">@Model.TotalClientes clientes · @Model.TotalCoaches coaches</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success-subtle text-success">
                        <i class="bi bi-credit-card-2-front-fill fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Suscripciones</p>
                        <h4 class="fw-bold mb-0">@Model.TotalSuscripciones</h4>
                        <small class="text-success fw-semibold">@Model.SuscripcionesActivas activas</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-warning-subtle text-warning">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Ingresos del mes</p>
                        <h4 class="fw-bold mb-0">S/ @Model.IngresosMes.ToString("N2")</h4>
                        <small class="text-muted">@DateTime.Now.ToString("MMMM yyyy")</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-info-subtle text-info">
                        <i class="bi bi-calendar-check-fill fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0">Asistencias hoy</p>
                        <h4 class="fw-bold mb-0">@Model.AsistenciasHoy</h4>
                        <small class="text-muted">@DateTime.Today.ToString("dd/MM/yyyy")</small>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Segunda fila: contadores secundarios + últimos usuarios -->
    <div class="row g-3">

        <!-- Contadores secundarios -->
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h6 class="fw-semibold text-dark m-0">Resumen del sistema</h6>
                </div>
                <div class="card-body pt-2">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="d-flex align-items-center gap-2 text-muted">
                                <i class="bi bi-card-checklist text-primary"></i> Planes activos
                            </span>
                            <span class="badge bg-primary-subtle text-primary fw-semibold">@Model.TotalPlanes</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="d-flex align-items-center gap-2 text-muted">
                                <i class="bi bi-geo-alt-fill text-success"></i> Sedes registradas
                            </span>
                            <span class="badge bg-success-subtle text-success fw-semibold">@Model.TotalSedes</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="d-flex align-items-center gap-2 text-muted">
                                <i class="bi bi-person-badge-fill text-warning"></i> Coaches
                            </span>
                            <span class="badge bg-warning-subtle text-warning fw-semibold">@Model.TotalCoaches</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="d-flex align-items-center gap-2 text-muted">
                                <i class="bi bi-person-fill text-info"></i> Clientes
                            </span>
                            <span class="badge bg-info-subtle text-info fw-semibold">@Model.TotalClientes</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Últimos usuarios registrados -->
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-semibold text-dark m-0">Últimos usuarios registrados</h6>
                    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todos</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small text-uppercase">
                                <tr>
                                    <th class="ps-3">Nombre</th>
                                    <th>Email</th>
                                    <th>Rol</th>
                                    <th>Registro</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.UltimosUsuarios) {
                                <tr>
                                    <td class="ps-3 fw-medium">
                                        <i class="bi bi-person-circle text-secondary me-1"></i>
                                        @u.NombreCompleto
                                    </td>
                                    <td class="text-muted small">@u.Email</td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary fw-semibold">@u.Rol</span>
                                    </td>
                                    <td class="text-muted small text-nowrap">@u.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
