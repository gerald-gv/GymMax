@model IEnumerable<GymMax.Models.Suscripcion>
@using GymMax.Enums
@{
    ViewData["Title"] = "Mi Portal";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var nombre = User.Identity?.Name ?? "Cliente";
    var reembolsos = ViewBag.Reembolsos as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
}

<style>
    .portal-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 0.85rem;
    }

        .portal-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.06) !important;
        }
</style>

<div class="container py-4">

    <!-- Encabezado de bienvenida -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-1 text-dark">Bienvenido, @nombre</h2>
            <p class="text-secondary mb-0 fs-6">Gestiona tus suscripciones activas e historial de membresías.</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Perfil" asp-action="Index"
               class="btn btn-outline-primary fw-semibold px-3 py-2 rounded-3 d-inline-flex align-items-center gap-2">
                <i class="bi bi-person-fill"></i>
                Mi perfil
            </a>

            <a asp-controller="Cliente" asp-action="Planes"
               class="btn btn-primary fw-semibold px-3 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-bag-plus-fill"></i>
                Ver planes
            </a>

            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                <button type="submit"
                        class="btn btn-outline-secondary fw-semibold px-3 py-2 rounded-3 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-right"></i>
                    Cerrar sesión
                </button>
            </form>
        </div>
    </div>

    <!-- Alertas de resultado -->
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
            <div>@TempData["Exito"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Listado de Suscripciones -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5 rounded-4 bg-white">
            <div class="mb-3">
                <span class="bg-light p-3 rounded-circle d-inline-flex align-items-center justify-content-center text-secondary">
                    <i class="bi bi-journal-x fs-1"></i>
                </span>
            </div>
            <h5 class="fw-bold text-dark mt-2">Aún no tienes suscripciones</h5>
            <p class="text-secondary small mb-4" style="max-width: 400px; margin: 0 auto;">Explora nuestros planes disponibles para comenzar a disfrutar de los beneficios del gimnasio.</p>
            <a asp-controller="Cliente" asp-action="Planes" class="btn btn-primary fw-semibold px-4 py-2 rounded-3 mx-auto shadow-sm">
                <i class="bi bi-lightning-charge-fill me-1"></i> Ver planes disponibles
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var s in Model)
            {
                var hoy = DateOnly.FromDateTime(DateTime.Today);
                var activa = s.Estado == EstadoSuscripcion.Activa && s.FechaFin >= hoy;
                var badgeClass = activa ? "bg-success-subtle text-success border border-success-subtle" : (s.Estado == EstadoSuscripcion.Cancelada ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle");
                var badgeText = activa ? "Activa" : s.Estado.ToString();
                var diasRestantes = activa ? (s.FechaFin.DayNumber - hoy.DayNumber) : 0;

                <div class="col-12 col-md-6">
                    <div class="card border-0 shadow-sm h-100 portal-card bg-white">
                        <div class="card-body p-4 d-flex flex-column">

                            <!-- Header de la tarjeta -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold text-dark m-0 fs-5">@s.Plan.Nombre</h5>
                                <span class="badge @badgeClass fw-semibold px-2.5 py-1.5 rounded-pill small">
                                    <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i> @badgeText
                                </span>
                            </div>

                            <p class="text-secondary small mb-3">@s.Plan.Descripcion</p>

                            <!-- Detalles de la suscripción -->
                            <div class="bg-light p-3 rounded-3 mb-3">
                                <div class="row g-2 small">
                                    <div class="col-6">
                                        <span class="text-secondary d-block">Precio pagado</span>
                                        <span class="fw-bold text-dark fs-6">S/ @s.PrecioPactado.ToString("N2")</span>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-secondary d-block">Inicio</span>
                                        <span class="fw-semibold text-dark">@s.FechaInicio.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-secondary d-block">Vencimiento</span>
                                        <span class="fw-semibold text-dark">@s.FechaFin.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    @if (activa)
                                    {
                                        <div class="col-6">
                                            <span class="text-secondary d-block">Días restantes</span>
                                            <span class="fw-bold text-success">@diasRestantes días</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (activa)
                            {
                                <!-- Barra de progreso -->
                                <div class="mb-3">
                                    @{
                                        var total = (s.FechaFin.DayNumber - s.FechaInicio.DayNumber);
                                        var transcurrido = (hoy.DayNumber - s.FechaInicio.DayNumber);
                                        var pct = total > 0 ? Math.Clamp((int)((decimal)transcurrido / total * 100), 0, 100) : 100;
                                    }
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-secondary small">Progreso del plan</span>
                                        <span class="fw-semibold text-dark small">@pct%</span>
                                    </div>
                                    <div class="progress rounded-pill" style="height: 6px;">
                                        <div class="progress-bar bg-success rounded-pill" style="width: @pct%"></div>
                                    </div>
                                </div>

                                <!-- Acciones -->
                                <div class="mt-auto pt-2 border-top">
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm w-100 py-2 fw-semibold rounded-3 d-inline-flex align-items-center justify-content-center gap-1.5"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalCancelar-@s.SuscripcionId">
                                        <i class="bi bi-x-circle"></i> Cancelar suscripción
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Modal de confirmación de cancelación -->
                @if (activa)
                {
                    var montoReembolso = reembolsos.GetValueOrDefault(s.SuscripcionId, 0m);
                    <div class="modal fade" id="modalCancelar-@s.SuscripcionId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold text-dark">¿Cancelar suscripción?</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body text-secondary py-3">
                                    <p class="mb-3">Estás a punto de cancelar tu suscripción al plan <strong class="text-dark">@s.Plan.Nombre</strong>.</p>
                                    @if (montoReembolso > 0)
                                    {
                                        var diasTotalesModal = s.FechaFin.DayNumber - s.FechaInicio.DayNumber;
                                        var diasRestantesModal = s.FechaFin.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
                                        <div class="alert alert-info border-0 bg-info-subtle text-info-emphasis small mb-0 rounded-3">
                                            <div class="d-flex gap-2">
                                                <i class="bi bi-info-circle-fill fs-5 text-info"></i>
                                                <div>
                                                    Recibirás un reembolso proporcional de <strong class="text-dark">S/ @montoReembolso.ToString("N2")</strong>
                                                    por los <strong>@diasRestantesModal días restantes</strong> de tu plan (@diasTotalesModal días totales).
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning border-0 bg-warning-subtle text-warning-emphasis small mb-0 rounded-3">
                                            <div class="d-flex gap-2">
                                                <i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i>
                                                <div>
                                                    No aplica reembolso proporcional para esta cancelación según los términos del plan.
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="modal-footer border-0 bg-light">
                                    <button type="button" class="btn btn-outline-secondary rounded-3 fw-semibold" data-bs-dismiss="modal">Mantener plan</button>
                                    <form asp-controller="Cliente" asp-action="CancelarSuscripcion" asp-route-id="@s.SuscripcionId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-danger rounded-3 fw-semibold d-inline-flex align-items-center gap-1.5">
                                            <i class="bi bi-x-circle"></i> Sí, cancelar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>
