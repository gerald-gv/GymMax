@model IEnumerable<GymMax.Models.Plan>
@{
    ViewData["Title"] = "Nuestros Planes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .plan-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        border-radius: 0.85rem;
    }

        .plan-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.08) !important;
        }

    .price-amount {
        letter-spacing: -0.5px;
    }
</style>

<div class="container py-4">
    <!-- Header de la sección -->
    <div class="text-center mb-5 me-auto ms-auto" style="max-width: 650px;">
        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">
            <i class="bi bi-lightning-charge-fill me-1"></i> Membresías GymMax
        </span>
        <h2 class="fw-bold display-6 text-dark">Elige el plan ideal para ti</h2>
        <p class="text-secondary fs-6">Selecciona la suscripción que mejor se adapte a tus metas de entrenamiento y empieza hoy mismo.</p>
    </div>

    <!-- Rejilla de Planes -->
    <div class="row g-4 justify-content-center align-items-stretch">
        @foreach (var plan in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 plan-card bg-white position-relative overflow-hidden">

                    <div class="card-body p-4 p-xl-5 d-flex flex-column">
                        <!-- Título y Duración -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h4 class="fw-bold text-dark m-0 fs-5">@plan.Nombre</h4>
                            <span class="badge bg-light text-dark border fw-normal px-2.5 py-1.5 rounded-2 d-inline-flex align-items-center">
                                <i class="bi bi-clock-history me-1.5 text-primary"></i> @plan.DuracionDias días
                            </span>
                        </div>

                        <!-- Precio -->
                        <div class="my-3 pb-3 border-bottom">
                            <div class="d-flex align-items-baseline">
                                <span class="fs-5 fw-semibold text-secondary me-1">S/</span>
                                <span class="display-6 fw-bold text-dark price-amount">@plan.Precio.ToString("N2")</span>
                            </div>
                        </div>

                        <!-- Descripción / Beneficios -->
                        <p class="text-secondary small flex-grow-1 mb-4 lh-lg">
                            <i class="bi bi-check2-circle text-success me-1"></i> @plan.Descripcion
                        </p>

                        <!-- Botón de Acción -->
                        <div class="mt-auto pt-2">
                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Cliente"))
                            {
                                <a asp-controller="PagoMP" asp-action="Confirmar" asp-route-planId="@plan.PlanId"
                                   class="btn btn-primary w-100 py-2.5 fw-semibold rounded-3 d-inline-flex align-items-center justify-content-center gap-2 shadow-sm">
                                    <i class="bi bi-bag-check-fill fs-6"></i> Elegir Plan
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Auth" asp-action="Login"
                                   class="btn btn-outline-primary w-100 py-2.5 fw-semibold rounded-3 d-inline-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-person-fill fs-6"></i> Regístrate para suscribirte
                                </a>
                            }
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>