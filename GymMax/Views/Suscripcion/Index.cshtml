@model IEnumerable<GymMax.Models.Suscripcion>
@using GymMax.Enums
@{ 
    ViewData["Title"] = "Suscripciones"; 
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark m-0">Suscripciones</h2>
            <p class="text-muted small m-0">Gestiona las membresías activas del gimnasio.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i><span>Nueva Suscripción</span>
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-3">Cliente</th>
                            <th>Plan</th>
                            <th>@Html.DisplayNameFor(m => m.PrecioPactado)</th>
                            <th>@Html.DisplayNameFor(m => m.FechaInicio)</th>
                            <th>@Html.DisplayNameFor(m => m.FechaFin)</th>
                            <th>@Html.DisplayNameFor(m => m.Estado)</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                        <tr>
                            <td class="ps-3 fw-medium">
                                <i class="bi bi-person-fill text-primary me-1"></i>
                                @item.Usuario?.Nombres @item.Usuario?.Apellidos
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Plan?.Nombre</span>
                            </td>
                            <td class="fw-semibold">S/ @item.PrecioPactado.ToString("N2")</td>
                            <td class="text-nowrap">@Html.DisplayFor(_ => item.FechaInicio)</td>
                            <td class="text-nowrap">@Html.DisplayFor(_ => item.FechaFin)</td>
                            <td>
                                @switch (item.Estado) {
                                    case EstadoSuscripcion.Activa:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Activa</span>
                                        break;
                                    case EstadoSuscripcion.Vencida:
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Vencida</span>
                                        break;
                                    case EstadoSuscripcion.Cancelada:
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cancelada</span>
                                        break;
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit"    asp-route-id="@item.SuscripcionId" class="btn btn-outline-primary" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.SuscripcionId" class="btn btn-outline-info"    title="Detalles"><i class="bi bi-eye-fill"></i></a>
                                    <a asp-action="Delete"  asp-route-id="@item.SuscripcionId" class="btn btn-outline-danger"  title="Eliminar"><i class="bi bi-trash-fill"></i></a>
                                </div>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
