@model IEnumerable<GymMax.Models.Suscripcion>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UsuarioId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PlanId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioPactado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaInicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaFin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Plan)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.UsuarioId)
            </td>
            <td>
                @Html.DisplayFor(model => item.PlanId)
            </td>
            <td>
                @Html.DisplayFor(model => item.PrecioPactado)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaInicio)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaFin)
            </td>
            <td>
                @Html.DisplayFor(model => item.Estado)
            </td>
            <td>
                @Html.DisplayFor(model => item.Usuario)
            </td>
            <td>
                @Html.DisplayFor(model => item.Plan)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SuscripcionId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.SuscripcionId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.SuscripcionId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
