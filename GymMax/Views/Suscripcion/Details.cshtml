@model GymMax.Models.Suscripcion
@using GymMax.Enums
@{ 
    ViewData["Title"] = "Detalle de Suscripción"; 
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark m-0">Detalle de Suscripción</h2>
        <p class="text-muted small m-0">Información completa de la membresía.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i><span>Volver</span>
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:560px;">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-secondary small text-uppercase">Cliente</dt>
            <dd class="col-sm-8 fw-semibold">@Model.Usuario?.Nombres @Model.Usuario?.Apellidos</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">Plan</dt>
            <dd class="col-sm-8">@Model.Plan?.Nombre</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.PrecioPactado)</dt>
            <dd class="col-sm-8 fw-semibold">S/ @Model.PrecioPactado.ToString("N2")</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.FechaInicio)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.FechaInicio)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.FechaFin)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.FechaFin)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Estado)</dt>
            <dd class="col-sm-8">
                @switch (Model.Estado) {
                    case EstadoSuscripcion.Activa:
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Activa</span>
                        break;
                    case EstadoSuscripcion.Vencida:
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Vencida</span>
                        break;
                    case EstadoSuscripcion.Cancelada:
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cancelada</span>
                        break;
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.SuscripcionId" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-pencil-fill"></i> Editar
        </a>
        <a asp-action="Delete" asp-route-id="@Model.SuscripcionId" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-trash-fill"></i> Eliminar
        </a>
    </div>
</div>
