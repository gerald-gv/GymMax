@model GymMax.Models.Suscripcion
@using GymMax.Enums
@{ ViewData["Title"] = "Editar Suscripción"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark m-0">Editar Suscripción</h2>
        <p class="text-muted small m-0">Modifica los datos de la suscripción seleccionada.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i><span>Volver</span>
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:560px;">
    <div class="card-body p-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <input type="hidden" asp-for="SuscripcionId" />
            <div class="row g-3 mb-3">
                <div class="col">
                    <label asp-for="UsuarioId" class="form-label fw-semibold"></label>
                    <input asp-for="UsuarioId" class="form-control" type="number" />
                    <span asp-validation-for="UsuarioId" class="text-danger small"></span>
                </div>
                <div class="col">
                    <label asp-for="PlanId" class="form-label fw-semibold"></label>
                    <input asp-for="PlanId" class="form-control" type="number" />
                    <span asp-validation-for="PlanId" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="PrecioPactado" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text">S/</span>
                    <input asp-for="PrecioPactado" class="form-control" type="number" step="0.01" min="0" />
                </div>
                <span asp-validation-for="PrecioPactado" class="text-danger small"></span>
            </div>
            <div class="row g-3 mb-3">
                <div class="col">
                    <label asp-for="FechaInicio" class="form-label fw-semibold"></label>
                    <input asp-for="FechaInicio" class="form-control" type="date" />
                    <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                </div>
                <div class="col">
                    <label asp-for="FechaFin" class="form-label fw-semibold"></label>
                    <input asp-for="FechaFin" class="form-control" type="date" />
                    <span asp-validation-for="FechaFin" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="Estado" class="form-label fw-semibold"></label>
                <select asp-for="Estado" class="form-select"
                    asp-items="Html.GetEnumSelectList<EstadoSuscripcion>()"></select>
                <span asp-validation-for="Estado" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-floppy-fill"></i><span>Guardar cambios</span>
            </button>
        </form>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
