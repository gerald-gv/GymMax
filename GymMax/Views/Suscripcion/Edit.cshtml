@model GymMax.Models.Suscripcion
@using GymMax.Enums
@{ ViewData["Title"] = "Editar Suscripción"; 
Layout = "~/Views/Shared/_LayoutDashboard.cshtml";}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark m-0">Editar Suscripción</h2>
        <p class="text-muted small m-0">Modifica los datos de la suscripción seleccionada.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i><span>Volver</span>
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:560px;">
    <div class="card-body p-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <input type="hidden" asp-for="SuscripcionId" />
            <input type="hidden" asp-for="UsuarioId" />
            <input type="hidden" asp-for="PrecioPactado" />
            <input type="hidden" asp-for="FechaInicio" />

            <!-- Datos no editables, solo lectura -->
            <div class="mb-3">
                <label class="form-label fw-semibold">Cliente</label>
                <input class="form-control bg-light" value="@ViewBag.NombreCliente" readonly />
                <small class="text-muted">No se puede reasignar la suscripción a otro cliente.</small>
            </div>

            <div class="row g-3 mb-3">
                <div class="col">
                    <label class="form-label fw-semibold">Precio Pactado</label>
                    <div class="input-group">
                        <span class="input-group-text">S/</span>
                        <input class="form-control bg-light" value="@Model.PrecioPactado.ToString("0.00")" readonly />
                    </div>
                </div>
                <div class="col">
                    <label class="form-label fw-semibold">Fecha Inicio</label>
                    <input class="form-control bg-light" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" readonly />
                </div>
            </div>

            <hr class="my-4" />

            <!-- Datos editables -->
            <div class="mb-3">
                <label asp-for="PlanId" class="form-label fw-semibold">Plan</label>
                <select asp-for="PlanId" class="form-select" asp-items="ViewBag.PlanId" id="selectPlan">
                    <option value="">— Selecciona un plan —</option>
                </select>
                <span asp-validation-for="PlanId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaFin" class="form-label fw-semibold"></label>
                <input asp-for="FechaFin" class="form-control" type="date" id="inputFechaFin" />
                <small class="text-muted">Se sugiere según la duración del plan, pero puedes ajustarla.</small>
                <span asp-validation-for="FechaFin" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Estado" class="form-label fw-semibold"></label>
                <select asp-for="Estado" class="form-select"
                        asp-items="Html.GetEnumSelectList<EstadoSuscripcion>()"></select>
                <span asp-validation-for="Estado" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-floppy-fill"></i><span>Guardar cambios</span>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const planes = @Html.Raw(ViewBag.PlanesJson ?? "{}");

        // Fecha de inicio ORIGINAL de la suscripción (no la de hoy)
        const fechaInicio = new Date("@Model.FechaInicio.ToString("yyyy-MM-dd")");

        document.getElementById('selectPlan').addEventListener('change', function() {
            const planId = this.value;
            const inputFechaFin = document.getElementById('inputFechaFin');

            if (planId && planes[planId] !== undefined) {
                const fechaFin = new Date(fechaInicio);
                fechaFin.setDate(fechaFin.getDate() + planes[planId].duracionDias);
                inputFechaFin.value = fechaFin.toISOString().split('T')[0];
            }
            // Si no selecciona plan válido, no tocamos FechaFin (a diferencia de Create,
            // aquí ya había un valor previo cargado que no queremos borrar innecesariamente)
        });
    </script>
}
