@model IEnumerable<GymMax.Models.Coach>
@{ 
    ViewData["Title"] = "Coaches"; 
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark m-0">Coaches</h2>
            <p class="text-muted small m-0">Gestiona el personal de entrenamiento del gimnasio.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-3">Nombre</th>
                            <th>Sede</th>
                            <th>@Html.DisplayNameFor(m => m.FechaIngreso)</th>
                            <th>@Html.DisplayNameFor(m => m.Activo)</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                        <tr>
                            <td class="ps-3 fw-medium">
                                <i class="bi bi-person-badge-fill text-primary me-1"></i>
                                @item.Usuario?.Nombres @item.Usuario?.Apellidos
                            </td>
                            <td>
                                @if (item.Sede != null) {
                                    <span class="badge bg-light text-dark border">@item.Sede.Nombre</span>
                                } else {
                                    <span class="text-muted small">Sin sede</span>
                                }
                            </td>
                            <td class="text-nowrap">@Html.DisplayFor(_ => item.FechaIngreso)</td>
                            <td>
                                @if (item.Activo) {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                } else {
                                    <span class="badge bg-secondary-subtle text-secondary border">Inactivo</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.CoachId" class="btn btn-outline-primary" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.CoachId" class="btn btn-outline-info" title="Detalles"><i class="bi bi-eye-fill"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.CoachId" class="btn btn-outline-danger" title="Eliminar"><i class="bi bi-trash-fill"></i></a>
                                </div>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
