@model GymMax.Models.Coach
@{ ViewData["Title"] = "Nuevo Coach"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark m-0">Nuevo Coach</h2>
        <p class="text-muted small m-0">Completa los datos para registrar un nuevo coach.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i><span>Volver</span>
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:560px;">
    <div class="card-body p-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <div class="mb-3">
                <label asp-for="UsuarioId" class="form-label fw-semibold"></label>
                <input asp-for="UsuarioId" class="form-control" type="number" />
                <span asp-validation-for="UsuarioId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SedeId" class="form-label fw-semibold"></label>
                <input asp-for="SedeId" class="form-control" type="number" />
                <span asp-validation-for="SedeId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FechaIngreso" class="form-label fw-semibold"></label>
                <input asp-for="FechaIngreso" class="form-control" type="date" />
                <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
            </div>
            <div class="mb-4 form-check">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label fw-semibold"></label>
            </div>
            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-floppy-fill"></i><span>Guardar</span>
            </button>
        </form>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
