@model GymMax.Models.Coach
@{ 
    ViewData["Title"] = "Editar Coach"; 
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark m-0">Editar Coach</h2>
        <p class="text-muted small m-0">Modifica los datos del coach seleccionado.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i><span>Volver</span>
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:560px;">
    <div class="card-body p-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <input type="hidden" asp-for="CoachId" />
            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary small text-uppercase">Coach</label>
                <p class="form-control-plaintext fw-medium">
                    <i class="bi bi-person-badge-fill text-primary me-1"></i>
                    @Model.Usuario?.Nombres @Model.Usuario?.Apellidos
                </p>
            </div>
            <div class="mb-3">
                <label asp-for="SedeId" class="form-label fw-semibold"></label>
                <select asp-for="SedeId" class="form-select" asp-items="ViewBag.SedeId">
                    <option value="">— Sin sede asignada —</option>
                </select>
                <span asp-validation-for="SedeId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FechaIngreso" class="form-label fw-semibold"></label>
                <input asp-for="FechaIngreso" class="form-control" type="date" />
                <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
            </div>
            <div class="mb-4 form-check">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label fw-semibold"></label>
            </div>
            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-floppy-fill"></i><span>Guardar cambios</span>
            </button>
        </form>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
