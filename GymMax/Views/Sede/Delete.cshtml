@model GymMax.Models.Sede
@{ 
    ViewData["Title"] = "Eliminar Sede";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark m-0">Eliminar Sede</h2>
        <p class="text-muted small m-0">Esta acción no se puede deshacer.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i><span>Volver</span>
    </a>
</div>

<div class="card border-0 border-danger shadow-sm" style="max-width:560px;">
    <div class="card-header bg-danger-subtle border-0">
        <div class="d-flex align-items-center gap-2 text-danger fw-semibold">
            <i class="bi bi-exclamation-triangle-fill"></i>
            ¿Confirmas la eliminación de esta sede?
        </div>
    </div>
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Nombre)</dt>
            <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(m => m.Nombre)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Direccion)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Direccion)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Telefono)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Telefono)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Horario)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Horario)</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        <form asp-action="Delete">
            <input type="hidden" asp-for="SedeId" />
            <button type="submit" class="btn btn-danger d-inline-flex align-items-center gap-2">
                <i class="bi bi-trash-fill"></i> Confirmar eliminación
            </button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="bi bi-x-circle"></i> Cancelar
        </a>
    </div>
</div>
