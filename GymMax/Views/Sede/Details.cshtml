@model GymMax.Models.Sede
@{ ViewData["Title"] = "Detalle de Sede"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark m-0">Detalle de Sede</h2>
        <p class="text-muted small m-0">Información completa de la sede seleccionada.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i><span>Volver</span>
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:560px;">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Nombre)</dt>
            <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(m => m.Nombre)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Direccion)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Direccion)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Telefono)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Telefono)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Horario)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Horario)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Activo)</dt>
            <dd class="col-sm-8">
                @if (Model.Activo) {
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Activa</span>
                } else {
                    <span class="badge bg-secondary-subtle text-secondary border">Inactiva</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.SedeId" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-pencil-fill"></i> Editar
        </a>
        <a asp-action="Delete" asp-route-id="@Model.SedeId" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-trash-fill"></i> Eliminar
        </a>
    </div>
</div>
