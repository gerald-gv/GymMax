@model IEnumerable<GymMax.Models.Sede>
@{
    ViewData["Title"] = "Sedes";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark m-0">Sedes</h2>
            <p class="text-muted small m-0">Administra las sucursales del gimnasio.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i><span>Nueva Sede</span>
        </a>
    </div>

    <!-- FILTROS -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Nombre</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="nombre" value="@ViewBag.FiltroNombre"
                                   class="form-control bg-light border-start-0" placeholder="Buscar por nombre..." />
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-3">
                        <label class="form-label small fw-semibold text-secondary">Estado</label>
                        <select name="activo" class="form-select bg-light">
                            <option value="">Todos</option>
                            <option value="true"  selected="@(ViewBag.FiltroActivo == true  ? "selected" : null)">Activa</option>
                            <option value="false" selected="@(ViewBag.FiltroActivo == false ? "selected" : null)">Inactiva</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100" title="Filtrar">
                            <i class="bi bi-funnel-fill"></i>
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100" title="Limpiar filtros">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-3">@Html.DisplayNameFor(m => m.Nombre)</th>
                            <th>@Html.DisplayNameFor(m => m.Direccion)</th>
                            <th>@Html.DisplayNameFor(m => m.Telefono)</th>
                            <th>@Html.DisplayNameFor(m => m.Horario)</th>
                            <th>@Html.DisplayNameFor(m => m.Activo)</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                        <tr>
                            <td class="ps-3 fw-medium">
                                <i class="bi bi-geo-alt-fill text-primary me-1"></i>
                                @Html.DisplayFor(_ => item.Nombre)
                            </td>
                            <td class="text-muted">@Html.DisplayFor(_ => item.Direccion)</td>
                            <td>@Html.DisplayFor(_ => item.Telefono)</td>
                            <td><span class="badge bg-light text-dark border">@Html.DisplayFor(_ => item.Horario)</span></td>
                            <td>
                                @if (item.Activo) {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Activa</span>
                                } else {
                                    <span class="badge bg-secondary-subtle text-secondary border">Inactiva</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.SedeId" class="btn btn-outline-primary" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.SedeId" class="btn btn-outline-info" title="Detalles"><i class="bi bi-eye-fill"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.SedeId" class="btn btn-outline-danger" title="Eliminar"><i class="bi bi-trash-fill"></i></a>
                                </div>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
