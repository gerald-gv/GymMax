@{
    ViewData["Title"] = "Nuestras Sedes";
}

<section class="bg-gray-900 text-white py-20">

    <div class="max-w-7xl mx-auto px-6 text-center">

        <h1 class="text-5xl font-bold">

            Nuestras Sedes

        </h1>

        <p class="mt-5 text-gray-300">

            Encuentra el gimnasio GymMax más cercano y comienza a entrenar.

        </p>

    </div>

</section>

<section class="py-20 bg-gray-100">

    <div class="max-w-7xl mx-auto px-6 space-y-10">

        @for (int i = 1; i <= 3; i++)
        {
            <div class="bg-white rounded-xl shadow-lg p-8 flex flex-col lg:flex-row justify-between items-center gap-8">

                <div>

                    <h2 class="text-3xl font-bold">

                        GymMax Sede @i

                    </h2>

                    <p class="mt-4 text-gray-600">

                        <i class="fa-solid fa-location-dot text-red-600"></i>

                        Av. Principal 123

                    </p>

                    <p class="mt-2 text-gray-600">

                        <i class="fa-solid fa-phone text-red-600"></i>

                        999 999 999

                    </p>

                    <p class="mt-2 text-gray-600">

                        <i class="fa-solid fa-clock text-red-600"></i>

                        Lunes - Sábado | 6:00 AM - 10:00 PM

                    </p>

                </div>

                <div>

                    <button class="bg-red-600 text-white px-8 py-3 rounded-lg hover:bg-red-700">

                        Ver ubicación

                    </button>

                </div>

            </div>
        }

    </div>

</section>