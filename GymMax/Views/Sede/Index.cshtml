@model IEnumerable<GymMax.Models.Sede>
@{ ViewData["Title"] = "Sedes"; }

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark m-0">Sedes</h2>
            <p class="text-muted small m-0">Administra las sucursales del gimnasio.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i><span>Nueva Sede</span>
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-3">@Html.DisplayNameFor(m => m.Nombre)</th>
                            <th>@Html.DisplayNameFor(m => m.Direccion)</th>
                            <th>@Html.DisplayNameFor(m => m.Telefono)</th>
                            <th>@Html.DisplayNameFor(m => m.Horario)</th>
                            <th>@Html.DisplayNameFor(m => m.Activo)</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                        <tr>
                            <td class="ps-3 fw-medium">
                                <i class="bi bi-geo-alt-fill text-primary me-1"></i>
                                @Html.DisplayFor(_ => item.Nombre)
                            </td>
                            <td class="text-muted">@Html.DisplayFor(_ => item.Direccion)</td>
                            <td>@Html.DisplayFor(_ => item.Telefono)</td>
                            <td><span class="badge bg-light text-dark border">@Html.DisplayFor(_ => item.Horario)</span></td>
                            <td>
                                @if (item.Activo) {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Activa</span>
                                } else {
                                    <span class="badge bg-secondary-subtle text-secondary border">Inactiva</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.SedeId" class="btn btn-outline-primary" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.SedeId" class="btn btn-outline-info" title="Detalles"><i class="bi bi-eye-fill"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.SedeId" class="btn btn-outline-danger" title="Eliminar"><i class="bi bi-trash-fill"></i></a>
                                </div>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
