@model GymMax.DTOs.CambiarPasswordDTO

@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="container py-4" style="max-width: 480px;">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-key-fill me-2 text-primary"></i>
                Cambiar Contraseña
            </h2>
            <p class="text-secondary mb-0">
                Actualiza tu contraseña de acceso.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

            <form asp-action="CambiarPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 small"></div>

                <div class="mb-3">
                    <label asp-for="PasswordActual" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="PasswordActual" type="password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="PasswordActual" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PasswordNueva" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="PasswordNueva" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="PasswordNueva" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmarPasswordNueva" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="ConfirmarPasswordNueva" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmarPasswordNueva" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 pt-3 border-top">
                    <button type="submit"
                            class="btn btn-primary rounded-3 fw-semibold px-4 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-check-lg"></i>
                        Cambiar Contraseña
                    </button>
                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-3 fw-semibold px-4 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-x-lg"></i>
                        Cancelar
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}