@model GymMax.DTOs.EditarPerfilDTO

@{
    ViewData["Title"] = "Editar Perfil";
}
<div class="container py-4" style="max-width: 560px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-pencil-square me-2 text-primary"></i>
                Editar Perfil
            </h2>
            <p class="text-secondary mb-0">
                Actualiza tu correo y número de teléfono.
            </p>
        </div>
    </div>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Editar" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 small"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Telefono" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="Telefono"
                           class="form-control"
                           type="tel"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           maxlength="9"
                           oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 9)"
                           autocomplete="tel" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2 pt-3 border-top">
                    <button type="submit"
                            class="btn btn-primary rounded-3 fw-semibold px-4 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-floppy-fill"></i>
                        Guardar Cambios
                    </button>
                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-3 fw-semibold px-4 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-x-lg"></i>
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}