@{
    ViewData["Title"] = "Login";
}

<div class="flex items-center justify-center h-full px-4 py-10">

    <div class="w-full max-w-md rounded-xl bg-white p-8 shadow-xl">

        <div class="text-center">

            <i class="fa-solid fa-dumbbell text-5xl text-red-600"></i>

            <h2 class="mt-4 text-3xl font-bold">
                GymMax
            </h2>

            <p class="text-gray-500 mt-2">
                Inicia sesión para continuar
            </p>

        </div>

        <form class="mt-8 space-y-5">

            <div>

                <label class="block mb-2 font-medium">
                    Correo electrónico
                </label>

                <input
                    type="email"
                    class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:ring-2 focus:ring-red-500 focus:border-red-500">

            </div>

            <div>

                <label class="block mb-2 font-medium">
                    Contraseña
                </label>

                <input
                    type="password"
                    class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:ring-2 focus:ring-red-500 focus:border-red-500">

            </div>

            <button
                class="w-full rounded-lg bg-red-600 py-3 font-semibold text-white transition hover:bg-red-700">
                Iniciar sesión
            </button>

        </form>

    </div>

</div>