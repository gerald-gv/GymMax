@{
    ViewData["Title"] = "Acceso denegado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm text-center" style="width:100%;max-width:420px;">
    <div class="card-body p-4">
        <i class="bi bi-shield-lock-fill text-danger" style="font-size:3rem;"></i>
        <h4 class="fw-bold mt-3">Acceso denegado</h4>
        <p class="text-muted">No tienes permisos para acceder a esta página.</p>
        <form asp-controller="Auth" asp-action="Logout" method="post" class="mt-3">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Cerrar sesión</button>
        </form>
    </div>
</div>
