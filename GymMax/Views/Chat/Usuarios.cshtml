@model IEnumerable<GymMax.Domain.Entities.Usuario>

@{
    ViewData["Title"] = "Nueva conversación";
    Layout = User.IsInRole("Administrador")
        ? "~/Views/Shared/_LayoutDashboard.cshtml"
        : "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
<div class="container py-4">

    <!-- Encabezado -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">

        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-chat-plus-fill text-primary me-2"></i>
                Nueva conversación
            </h2>

            <p class="text-secondary mb-0">
                Selecciona un usuario para iniciar una conversación privada.
            </p>
        </div>

        <a asp-controller="Chat"
           asp-action="Index"
           class="btn btn-outline-secondary rounded-3 fw-semibold">

            <i class="bi bi-arrow-left me-1"></i>
            Volver al chat

        </a>

    </div>

    <!-- Mensaje de error -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

        </div>
    }
    <!-- Buscador -->
    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0">
                <i class="bi bi-search text-secondary"></i>
            </span>
            <input type="text"
                   id="buscarUsuario"
                   class="form-control bg-light border-start-0"
                   placeholder="Buscar por nombre, apellido o correo...">
        </div>
    </div>
    <!-- Lista de usuarios -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center p-5">

                    <i class="bi bi-people fs-1 text-secondary"></i>

                    <h5 class="fw-bold text-dark mt-3">
                        No hay otros usuarios disponibles
                    </h5>

                    <p class="text-secondary mb-0">
                        Actualmente no existen otros usuarios con los que puedas iniciar una conversación.
                    </p>

                </div>
            }
            else
            {
                <div class="list-group list-group-flush">

                    @foreach (var usuario in Model)
                    {
                        <div class="list-group-item border-0 border-bottom px-4 py-3"
                             data-busqueda="@($"{usuario.Nombres} {usuario.Apellidos} {usuario.Email}".ToLower())">

                            <div class="d-flex align-items-center">

                                <!-- Avatar -->
                                <div class="bg-primary-subtle text-primary rounded-circle
                                    d-flex align-items-center justify-content-center me-3"
                                     style="width: 48px; height: 48px;">

                                    <i class="bi bi-person-fill fs-4"></i>
                                </div>
                                <!-- Información -->
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold text-dark mb-1">
                                        @usuario.Nombres @usuario.Apellidos
                                    </h6>
                                    <div class="small text-secondary">
                                        <i class="bi bi-envelope me-1"></i>
                                        @usuario.Email
                                    </div>

                                </div>

                                <!-- Iniciar conversación -->
                                <form asp-controller="Chat"
                                      asp-action="CrearPrivada"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="usuarioDestinoId"
                                           value="@usuario.UsuarioId" />

                                    <button type="submit"
                                            class="btn btn-outline-primary rounded-3 fw-semibold">

                                        <i class="bi bi-chat-fill me-1"></i>
                                        Chat
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
                <div id="sinResultados" class="text-center p-5 d-none">
                    <i class="bi bi-search fs-1 text-secondary"></i>
                    <p class="text-secondary mt-2 mb-0">
                        No se encontraron usuarios con ese nombre.
                    </p>
                </div>
            }
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const buscarUsuario = document.getElementById("buscarUsuario");
        const usuarios = document.querySelectorAll("#listaUsuarios [data-busqueda], .list-group-item[data-busqueda]");
        const sinResultados = document.getElementById("sinResultados");

        function filtrarUsuarios() {
            const texto = buscarUsuario.value.toLowerCase().trim();
            let visibles = 0;

            usuarios.forEach(usuario => {
                const coincide = usuario.dataset.busqueda.includes(texto);
                usuario.classList.toggle("d-none", !coincide);
                if (coincide) visibles++;
            });

            if (sinResultados) {
                sinResultados.classList.toggle("d-none", visibles > 0);
            }
        }

        if (buscarUsuario) {
            buscarUsuario.addEventListener("input", filtrarUsuarios);
            buscarUsuario.addEventListener("keydown", e => {
                if (e.key === "Enter") e.preventDefault();
            });
        }
    </script>
}