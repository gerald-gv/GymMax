@model IEnumerable<GymMax.Models.Conversacion>
@using GymMax.Enums

@{
    ViewData["Title"] = "Chat";
    Layout = User.IsInRole("Administrador")
        ? "~/Views/Shared/_LayoutDashboard.cshtml"
        : "~/Views/Shared/_Layout.cshtml";

    var usuarioIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    int.TryParse(usuarioIdStr, out int usuarioId);
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
<div class="container py-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-chat-dots-fill text-primary me-2"></i>
                Chat
            </h2>

            <p class="text-secondary mb-0">
                Tus conversaciones y mensajes.
            </p>
        </div>

        <a asp-controller="Chat"
           asp-action="Usuarios"
           class="btn btn-primary fw-semibold rounded-3 d-inline-flex align-items-center gap-2">
            <i class="bi bi-chat-plus-fill"></i>
            Nueva conversación
        </a>
    </div>

    <!-- Mensajes -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
        </div>
    }

    <!-- Conversaciones -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">

            <div class="mb-3">
                <span class="bg-light p-3 rounded-circle d-inline-flex align-items-center justify-content-center">
                    <i class="bi bi-chat-square-text fs-1 text-secondary"></i>
                </span>
            </div>

            <h5 class="fw-bold text-dark">
                No tienes conversaciones
            </h5>

            <p class="text-secondary mb-4">
                Inicia una conversación privada con otro usuario.
            </p>

            <a asp-controller="Chat"
               asp-action="Usuarios"
               class="btn btn-primary rounded-3 fw-semibold px-4">
                <i class="bi bi-chat-plus-fill me-1"></i>
                Iniciar conversación
            </a>

        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var conversacion in Model)
            {
                string nombreConversacion;

                if (conversacion.Tipo == TipoConversacion.Grupo)
                {
                    nombreConversacion = conversacion.Nombre ?? "Grupo sin nombre";
                }
                else
                {
                    var otroUsuario = conversacion.Miembros
                        .FirstOrDefault(m => m.UsuarioId != usuarioId);

                    nombreConversacion = otroUsuario != null
                        ? $"{otroUsuario.Usuario.Nombres} {otroUsuario.Usuario.Apellidos}"
                        : "Conversación privada";
                }
                var icono = conversacion.Tipo == TipoConversacion.Grupo
                    ? "bi-people-fill"
                    : "bi-person-fill";
                var tipoTexto = conversacion.Tipo == TipoConversacion.Grupo
                    ? "Grupo"
                    : "Privada";
                <div class="col-12 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center">
                                <!-- Icono -->
                                <div class="bg-primary-subtle text-primary rounded-circle
                                    d-flex align-items-center justify-content-center me-3"
                                     style="width: 50px; height: 50px;">
                                    <i class="bi @icono fs-4"></i>
                                </div>
                                <!-- Información -->
                                <div class="flex-grow-1">
                                    <h5 class="fw-bold text-dark mb-1">
                                        @nombreConversacion
                                    </h5>
                                    <span class="badge bg-light text-secondary border">
                                        @tipoTexto
                                    </span>
                                </div>
                                <!-- Botón -->
                                <a asp-controller="Chat"
                                   asp-action="Abrir"
                                   asp-route-id="@conversacion.ConversacionId"
                                   class="btn btn-outline-primary rounded-3">
                                    <i class="bi bi-chat-fill"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
