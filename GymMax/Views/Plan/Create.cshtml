@model GymMax.Models.Plan
@{ ViewData["Title"] = "Nuevo Plan"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark m-0">Nuevo Plan</h2>
        <p class="text-muted small m-0">Completa los datos para registrar un nuevo plan.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i><span>Volver</span>
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:560px;">
    <div class="card-body p-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-semibold"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>
            <div class="row g-3 mb-3">
                <div class="col">
                    <label asp-for="DuracionDias" class="form-label fw-semibold"></label>
                    <input asp-for="DuracionDias" class="form-control" type="number" min="1" />
                    <span asp-validation-for="DuracionDias" class="text-danger small"></span>
                </div>
                <div class="col">
                    <label asp-for="Precio" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text">S/</span>
                        <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-4 form-check">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label fw-semibold"></label>
            </div>
            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-floppy-fill"></i><span>Guardar</span>
            </button>
        </form>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
