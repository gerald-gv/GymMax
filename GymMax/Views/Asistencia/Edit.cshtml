@model GymMax.Models.Asistencia
@{
    ViewData["Title"] = "Editar Asistencia";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark m-0">Editar Asistencia</h2>
        <p class="text-muted small m-0">Modifica los datos del registro de entrada.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i><span>Volver</span>
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:560px;">
    <div class="card-body p-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <input type="hidden" asp-for="AsistenciaId" />
            <div class="mb-3">
                <label asp-for="UsuarioId" class="form-label fw-semibold">Usuario</label>
                <select asp-for="UsuarioId" class="form-select" asp-items="ViewBag.UsuarioId">
                    <option value="">— Selecciona un usuario —</option>
                </select>
                <span asp-validation-for="UsuarioId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SedeId" class="form-label fw-semibold">Sede</label>
                <select asp-for="SedeId" class="form-select" asp-items="ViewBag.SedeId">
                    <option value="">— Selecciona una sede —</option>
                </select>
                <span asp-validation-for="SedeId" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="FechaHoraEntrada" class="form-label fw-semibold"></label>
                <input asp-for="FechaHoraEntrada" class="form-control" type="datetime-local" />
                <span asp-validation-for="FechaHoraEntrada" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-floppy-fill"></i><span>Guardar cambios</span>
            </button>
        </form>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
