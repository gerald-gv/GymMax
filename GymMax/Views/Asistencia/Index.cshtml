@model IEnumerable<GymMax.Models.Asistencia>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UsuarioId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SedeId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaHoraEntrada)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sede)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.UsuarioId)
            </td>
            <td>
                @Html.DisplayFor(model => item.SedeId)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaHoraEntrada)
            </td>
            <td>
                @Html.DisplayFor(model => item.Usuario)
            </td>
            <td>
                @Html.DisplayFor(model => item.Sede)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.AsistenciaId">Details</a>
                <a asp-action="Delete" asp-route-id="@item.AsistenciaId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
