@model IEnumerable<GymMax.Models.Asistencia>
@{ ViewData["Title"] = "Asistencias"; }

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark m-0">Asistencias</h2>
            <p class="text-muted small m-0">Registro de entradas de miembros y personal.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i><span>Registrar Asistencia</span>
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-3">Usuario</th>
                            <th>Sede</th>
                            <th>@Html.DisplayNameFor(m => m.FechaHoraEntrada)</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                        <tr>
                            <td class="ps-3 fw-medium">
                                <i class="bi bi-person-check-fill text-primary me-1"></i>
                                @item.Usuario?.Nombres @item.Usuario?.Apellidos
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Sede?.Nombre</span>
                            </td>
                            <td class="text-nowrap">@Html.DisplayFor(_ => item.FechaHoraEntrada)</td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.AsistenciaId" class="btn btn-outline-info" title="Detalles"><i class="bi bi-eye-fill"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.AsistenciaId" class="btn btn-outline-danger" title="Eliminar"><i class="bi bi-trash-fill"></i></a>
                                </div>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
