@model GymMax.Domain.Entities.Usuario
@using GymMax.Enums
@{ 
    ViewData["Title"] = "Editar Usuario";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark m-0">Editar Usuario</h2>
        <p class="text-muted small m-0">Modifica los datos del usuario seleccionado.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i><span>Volver</span>
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:640px;">
    <div class="card-body p-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <input type="hidden" asp-for="UsuarioId" />

            <div class="mb-3">
                <label asp-for="RolId" class="form-label fw-semibold"></label>
                <select asp-for="RolId" class="form-select" asp-items="ViewBag.RolId"></select>
                <span asp-validation-for="RolId" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col">
                    <label asp-for="Nombres" class="form-label fw-semibold"></label>
                    <input asp-for="Nombres" class="form-control" />
                    <span asp-validation-for="Nombres" class="text-danger small"></span>
                </div>
                <div class="col">
                    <label asp-for="Apellidos" class="form-label fw-semibold"></label>
                    <input asp-for="Apellidos" class="form-control" />
                    <span asp-validation-for="Apellidos" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col">
                    <label asp-for="Dni" class="form-label fw-semibold"></label>
                    <input asp-for="Dni" class="form-control" />
                    <span asp-validation-for="Dni" class="text-danger small"></span>
                </div>
                <div class="col">
                    <label asp-for="FechaNacimiento" class="form-label fw-semibold"></label>
                    <input asp-for="FechaNacimiento" class="form-control" type="date" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Telefono" class="form-label fw-semibold"></label>
                <input asp-for="Telefono" class="form-control" />
                <span asp-validation-for="Telefono" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Nueva Contraseña</label>
                <input name="NuevaPassword" type="password" class="form-control" placeholder="Dejar en blanco para conservar la actual" />
            </div>

            <div class="mb-3">
                <label asp-for="CodigoMembresia" class="form-label fw-semibold"></label>
                <input asp-for="CodigoMembresia" class="form-control bg-light" readonly />
                <small class="text-muted">Generado automáticamente, no editable.</small>
            </div>

            <div class="mb-4">
                <label asp-for="Estado" class="form-label fw-semibold"></label>
                <select asp-for="Estado" class="form-select"
                        asp-items="Html.GetEnumSelectList<EstadoUsuario>()"></select>
                <span asp-validation-for="Estado" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-floppy-fill"></i><span>Guardar cambios</span>
            </button>
        </form>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
