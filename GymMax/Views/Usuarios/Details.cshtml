@model GymMax.Domain.Entities.Usuario
@using GymMax.Enums
@{ ViewData["Title"] = "Detalle de Usuario"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark m-0">Detalle de Usuario</h2>
        <p class="text-muted small m-0">Información completa del usuario seleccionado.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i><span>Volver</span>
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:640px;">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-secondary small text-uppercase">Rol</dt>
            <dd class="col-sm-8">
                <span class="badge bg-secondary-subtle text-secondary fw-semibold">@Model.Rol?.Nombre</span>
            </dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Nombres)</dt>
            <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(m => m.Nombres)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Apellidos)</dt>
            <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(m => m.Apellidos)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Dni)</dt>
            <dd class="col-sm-8">
                <span class="badge bg-light text-dark border">@Html.DisplayFor(m => m.Dni)</span>
            </dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Email)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Email)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Telefono)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Telefono)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.FechaNacimiento)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.FechaNacimiento)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.CodigoMembresia)</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.CodigoMembresia)) {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@Model.CodigoMembresia</span>
                } else {
                    <span class="text-muted">—</span>
                }
            </dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.FechaRegistro)</dt>
            <dd class="col-sm-8">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Estado)</dt>
            <dd class="col-sm-8">
                @if (Model.Estado == EstadoUsuario.Activo) {
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                } else {
                    <span class="badge bg-secondary-subtle text-secondary border">Inactivo</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.UsuarioId" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-pencil-fill"></i> Editar
        </a>
        <a asp-action="Delete" asp-route-id="@Model.UsuarioId" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-trash-fill"></i> Eliminar
        </a>
    </div>
</div>
