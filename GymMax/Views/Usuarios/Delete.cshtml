@model GymMax.Domain.Entities.Usuario
@using GymMax.Enums
@{ ViewData["Title"] = "Eliminar Usuario"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark m-0">Eliminar Usuario</h2>
        <p class="text-muted small m-0">Esta acción no se puede deshacer.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i><span>Volver</span>
    </a>
</div>

<div class="card border-0 border-danger shadow-sm" style="max-width:640px;">
    <div class="card-header bg-danger-subtle border-0">
        <div class="d-flex align-items-center gap-2 text-danger fw-semibold">
            <i class="bi bi-exclamation-triangle-fill"></i>
            ¿Confirmas la eliminación de este usuario?
        </div>
    </div>
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-secondary small text-uppercase">Rol</dt>
            <dd class="col-sm-8">
                <span class="badge bg-secondary-subtle text-secondary fw-semibold">@Model.Rol?.Nombre</span>
            </dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Nombres)</dt>
            <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(m => m.Nombres)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Apellidos)</dt>
            <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(m => m.Apellidos)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Dni)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Dni)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Email)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Email)</dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.Estado)</dt>
            <dd class="col-sm-8">
                @if (Model.Estado == EstadoUsuario.Activo) {
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                } else {
                    <span class="badge bg-secondary-subtle text-secondary border">Inactivo</span>
                }
            </dd>

            <dt class="col-sm-4 text-secondary small text-uppercase">@Html.DisplayNameFor(m => m.FechaRegistro)</dt>
            <dd class="col-sm-8">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        <form asp-action="Delete">
            <input type="hidden" asp-for="UsuarioId" />
            <button type="submit" class="btn btn-danger d-inline-flex align-items-center gap-2">
                <i class="bi bi-trash-fill"></i> Confirmar eliminación
            </button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="bi bi-x-circle"></i> Cancelar
        </a>
    </div>
</div>
