@model IEnumerable<Plan>

@{
    ViewData["Title"] = "Planes";
}

<!-- HERO -->
<section class="relative overflow-hidden bg-gray-950 py-20 text-white sm:py-24">

    <!-- BRILLO SUP DERECHO -->
    <div class="absolute -right-32 -top-32 h-72 w-72 rounded-full bg-red-600/10 blur-3xl"></div>

    <!-- BRILLO INF IZQUIERDO -->
    <div class="absolute -bottom-32 -left-32 h-72 w-72 rounded-full bg-red-600/10 blur-3xl"></div>

    <!-- CONTENIDO -->
    <div class="mx-auto max-w-7xl px-6 text-center sm:px-8">

        <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-red-500">
            <span class="h-px w-6 bg-red-500"></span>
            GymMax
            <span class="h-px w-6 bg-red-500"></span>
        </span>

        <h1 class="mt-5 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
            Nuestros planes
        </h1>

        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-gray-400 sm:text-lg">
            Elige la membresía que mejor se adapte a tus objetivos
            y comienza a entrenar con GymMax.
        </p>

    </div>

</section>

<!-- PLANES -->
<section class="bg-gray-100 py-20 sm:py-24">

    <!-- CONTENIDO -->
    <div class="mx-auto max-w-7xl px-6 sm:px-8">

        @if (!Model.Any()) {
            <div class="mx-auto max-w-xl py-16 text-center">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-gray-200 text-gray-400">
                    <i class="fa-solid fa-dumbbell text-2xl"></i>
                </div>
                <h2 class="mt-6 text-2xl font-bold text-gray-900">
                    No hay planes disponibles
                </h2>
                <p class="mt-3 leading-relaxed text-gray-500">
                    Actualmente no tenemos planes activos disponibles.
                    Vuelve a consultar más adelante.
                </p>
                <a asp-controller="Home" asp-action="Index" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-gray-950 px-6 py-3 font-semibold text-white transition duration-300 hover:bg-red-600">
                    Volver al inicio
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
            </div>
        } else {
            <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">

                @foreach (var plan in Model) {
                    <article class="group flex flex-col rounded-3xl border border-gray-200 bg-white p-8 shadow-lg transition duration-500 hover:-translate-y-2 hover:shadow-2xl">
                        <div class="flex items-center justify-between">
                            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-100 text-red-600 transition duration-300 group-hover:bg-red-600 group-hover:text-white">
                                <i class="fa-solid fa-dumbbell text-xl"></i>
                            </div>
                            @if (plan.Activo) {
                                <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">
                                    Disponible
                                </span>
                            } else {
                                <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">
                                    No Disponible
                                </span>
                            }
                        </div>
                        <div class="mt-7">
                            <h2 class="text-2xl font-bold text-gray-900">
                                @plan.Nombre
                            </h2>
                            <p class="mt-3 min-h-[48px] leading-relaxed text-gray-500">
                                @plan.Descripcion
                            </p>
                        </div>
                        <div class="mt-8">
                            <span class="text-4xl font-extrabold tracking-tight text-gray-950 sm:text-5xl">
                                S/@plan.Precio.ToString("0.00")
                            </span>
                        </div>
                        <div class="mt-6 flex items-center gap-3 border-t border-gray-100 pt-6">
                            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gray-100 text-gray-600">
                                <i class="fa-regular fa-calendar"></i>
                            </div>
                            <div>
                                <p class="text-xs font-medium uppercase tracking-wide text-gray-400">
                                    Duración
                                </p>
                                <p class="font-semibold text-gray-700">
                                    @plan.DuracionDias días
                                </p>
                            </div>
                        </div>
                        <div class="mt-6 flex-grow">
                            <div class="flex items-start gap-3 text-sm text-gray-600">
                                <i class="fa-solid fa-circle-check mt-0.5 text-red-500"></i>
                                <span> @plan.Descripcion </span>
                            </div>
                        </div>
                        <a asp-controller="Cliente" asp-action="Planes" class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gray-950 px-6 py-3.5 font-semibold text-white transition duration-300 hover:bg-red-600">
                            Elegir Plan
                            <i class="fa-solid fa-arrow-right text-sm transition-transform duration-300 group-hover:translate-x-1"></i>
                        </a>
                    </article>
                }
            </div>
        }
    </div>
</section>